(ns bonsai.pack-test
  "Real git is the oracle in both directions: `git verify-pack` must accept
   what bonsai.pack writes, and bonsai.pack must read what `git pack-objects`
   writes -- deltas included, which a pack this namespace encodes never
   contains, so the second test is the only one that reaches apply-delta
   through the pack reader. Files go through kotoba.io and git through
   kotoba.process, both of which run on the JVM and on kbb alike."
  (:require [kotoba.bytes :as kbytes] [kotoba.io :as kio] [bonsai.pack :as pack]
            [kotoba.lang.text :as str]
            [kotoba.process :as shell]
            [kotoba.test :refer [deftest is]]))

(defn utf8 [s] (kbytes/utf8-bytes ^String s))

(defn- rm-rf [dir]
  (doseq [f (reverse (kio/file-seq dir))] (kio/delete f)))

(defn- git [dir & args]
  (apply shell/sh "git" (concat args [:dir (kio/path dir)])))

(deftest pack-and-index-are-accepted-by-git
  (let [bytes (pack/encode [{:type "blob" :body (utf8 "hello\n")}
                            {:type "blob" :body (utf8 "world\n")}])
        objects (pack/decode bytes)
        idx (pack/encode-index-v2 objects bytes)
        dir (kio/temp-dir "bonsai-pack-")
        pack-file (kio/file dir "objects.pack") idx-file (kio/file dir "objects.idx")]
    (try
      (kio/write-bytes pack-file bytes)
      (kio/write-bytes idx-file idx)
      (let [{:keys [exit err]} (shell/sh "git" "verify-pack" "-v" (kio/path idx-file))]
        (is (zero? exit) err))
      (is (= ["blob" "blob"] (mapv :type objects)))
      (is (= ["ce013625030ba8dba906f756967f9e9ca394464a"
              "cc628ccd10742baea8241c5924df992b5c019f71"]
             (mapv :oid objects)))
      (finally (rm-rf dir)))))

(deftest git-written-pack-with-deltas-decodes-to-git-oids
  (let [dir (kio/temp-dir "bonsai-pack-git-")
        ;; Two large, nearly identical blobs: pack-objects stores one of them
        ;; as an OFS_DELTA against the other.
        base (apply str (map #(str "line " % " of a blob git will deltify\n") (range 200)))
        edited (str base "one more line\n")]
    (try
      (is (zero? (:exit (git dir "init" "-q" "."))))
      (kio/write-string (kio/file dir "a.txt") base)
      (kio/write-string (kio/file dir "b.txt") edited)
      (let [oids (mapv #(str/trim (:out (git dir "hash-object" "-w" %))) ["a.txt" "b.txt"])
            {:keys [exit out err]} (shell/sh "git" "pack-objects" "-q" "--window=10" "out"
                                             :dir (kio/path dir)
                                             :in (str (str/join "\n" oids) "\n"))
            pack-file (kio/file dir (str "out-" (str/trim out) ".pack"))
            verify (:out (shell/sh "git" "verify-pack" "-v"
                                   (str/replace (kio/path pack-file) #"\.pack$" ".idx")))
            objects (pack/decode (kio/read-all-bytes pack-file))]
        (is (zero? exit) err)
        (is (re-find #"chain length = 1: 1 object" verify)
            "the fixture must really contain a delta, or this test proves nothing")
        (is (= (set oids) (set (map :oid objects))))
        (is (= #{"blob"} (set (map :type objects))))
        (is (= #{base edited}
               (set (map #(kbytes/utf8-string (:body %)) objects)))))
      (finally (rm-rf dir)))))
