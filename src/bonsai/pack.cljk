(ns bonsai.pack
  "Git PACK v2 writer/reader and idx v2 writer. The writer emits full objects;
   the reader also resolves REF_DELTA and OFS_DELTA through bonsai.delta.

   The :cljs branch is what kbb (nbb, JVM-free) runs. It reaches for no host
   crypto or zlib: SHA-1 is kotoba.bytes.sha1, CRC-32 and zlib inflate are
   org-ietf-deflate -- the same pure definitions on every runtime, so a pack
   this namespace reads under kbb is judged by exactly the arithmetic a
   browser or an amu-compiled guest would apply, not by whatever Node links.
   Bytes cross the public boundary as Uint8Array (what bonsai.git-object and
   bonsai.loose-object hand out on cljs); inside, a pack is a vector of
   unsigned bytes, which is what `decode` already walked on the JVM."
  (:require [bonsai.delta :as delta]
            [bonsai.git-object :as object]
            [bonsai.loose-object :as loose]
            [multiformats.core :as mf]
            #?@(:cljs [[kotoba.bytes.sha1 :as sha1]
                       [deflate.checksum :as checksum]
                       [deflate.zlib :as zlib]]))
  #?(:clj (:import (java.io ByteArrayOutputStream)
                   (java.security MessageDigest)
                   (java.util.zip CRC32 Inflater DataFormatException))))

(def type->code {"commit" 1 "tree" 2 "blob" 3 "tag" 4})
(def code->type {1 "commit" 2 "tree" 3 "blob" 4 "tag"})
(defn- u8 [b] (bit-and (int b) 0xff))
(defn- ba [xs]
  #?(:clj (if (bytes? xs) xs (byte-array (map unchecked-byte xs)))
     ;; Uint8Array.from also takes kotoba.bytes' Int8Array (utf8-bytes on
     ;; kbb) and reduces each element mod 256 -- the unsigned reading of the
     ;; same octets, which is what a pack is made of.
     :cljs (if (instance? js/Uint8Array xs) xs (js/Uint8Array.from (clj->js (vec (map u8 xs)))))))
(defn- sha1 [b]
  #?(:clj (.digest (MessageDigest/getInstance "SHA-1") ^bytes (ba b))
     :cljs (sha1/sha1-bytes (mapv u8 b))))

;; The output accumulator: a ByteArrayOutputStream on the JVM, a volatile
;; vector of unsigned bytes on cljs. `snapshot` is `.toByteArray` -- encode
;; and encode-index-v2 both hash what has been written so far and then keep
;; writing the hash, so the accumulator has to be readable mid-stream.
(defn- out-buf [] #?(:clj (ByteArrayOutputStream.) :cljs (volatile! [])))
(defn- write! [out xs]
  #?(:clj (.write ^ByteArrayOutputStream out ^bytes (ba xs))
     :cljs (vswap! out into (map u8) xs)))
(defn- snapshot [out]
  #?(:clj (.toByteArray ^ByteArrayOutputStream out)
     :cljs (ba @out)))

(defn- u32 [n]
  ;; Four big-endian octets. Arithmetic, not bit-shift-right, on cljs: a CRC
  ;; or an object count is an unsigned 32-bit value and JS shifts are signed
  ;; int32, so 0x80000000 and above would come out negative there.
  #?(:clj (byte-array (map unchecked-byte [(bit-shift-right n 24) (bit-shift-right n 16)
                                           (bit-shift-right n 8) n]))
     :cljs [(mod (quot n 16777216) 256) (mod (quot n 65536) 256)
            (mod (quot n 256) 256) (mod n 256)]))
(defn- read-u32 [v p]
  (reduce (fn [n i] (+ (* n 256) (nth v i))) 0 (range p (+ p 4))))

(defn- entry-header [code size]
  (loop [n (unsigned-bit-shift-right size 4)
         out [(bit-or (bit-shift-left code 4) (bit-and size 0x0f))]]
    (if (zero? n)
      #?(:clj (byte-array (map unchecked-byte out)) :cljs out)
      (recur (unsigned-bit-shift-right n 7)
             (conj (update out (dec (count out)) bit-or 0x80) (bit-and n 0x7f))))))

(defn- byte-count [b] #?(:clj (alength ^bytes b) :cljs (.-length b)))

(defn encode
  "Encode full objects [{:type :body}] as PACK v2 bytes with trailer SHA-1."
  [objects]
  (let [out (out-buf)]
    (write! out [0x50 0x41 0x43 0x4b])                  ; "PACK"
    (write! out (u32 2))
    (write! out (u32 (count objects)))
    (doseq [{:keys [type body]} objects]
      (let [code (type->code type)
            body (ba body)]
        (when-not code (throw (ex-info "unsupported pack object type" {:type type})))
        (write! out (entry-header code (byte-count body)))
        (write! out (loose/deflate body))))
    (let [without-trailer (snapshot out)]
      (write! out (sha1 without-trailer))
      (snapshot out))))

#?(:clj
   (defn- inflate-at [bytes _v offset expected-size]
     (let [z (Inflater.) out (ByteArrayOutputStream.) buf (byte-array 8192)]
       (try
         (.setInput z ^bytes bytes offset (- (alength ^bytes bytes) offset 20))
         (while (not (.finished z))
           (let [n (.inflate z buf)]
             (when (and (zero? n) (or (.needsInput z) (.needsDictionary z)))
               (throw (ex-info "truncated pack zlib stream" {:reason :truncated-pack})))
             (.write out buf 0 n)))
         (let [body (.toByteArray out) consumed (- (- (alength ^bytes bytes) offset 20) (.getRemaining z))]
           (when-not (= expected-size (alength body))
             (throw (ex-info "pack object size mismatch" {:reason :pack-size})))
           [body consumed])
         (catch DataFormatException e (throw (ex-info "invalid pack zlib" {:reason :invalid-pack} e)))
         (finally (.end z)))))
   :cljs
   (defn- inflate-at
     "deflate.zlib/unwrap* over the bytes between `offset` and the trailer.
      Its :end counts the Adler-32 trailer, which is what Inflater consumes
      too, so the next entry starts at offset + :end on both runtimes.
      Inflate is capped at the declared size: a larger body is the same
      :pack-size failure the JVM reports after the fact, but refused while
      inflating rather than after the bomb has gone off. Adler-32 is
      verified, as zlib under Inflater verifies it."
     [_bytes v offset expected-size]
     (let [{:keys [bytes end]}
           (try
             (zlib/unwrap* (subvec v offset (- (count v) 20)) {:max-output expected-size})
             (catch :default e
               (throw (case (:reason (ex-data e))
                        :truncated (ex-info "truncated pack zlib stream" {:reason :truncated-pack} e)
                        :output-limit (ex-info "pack object size mismatch" {:reason :pack-size} e)
                        :dictionary-required (ex-info "truncated pack zlib stream" {:reason :truncated-pack} e)
                        (ex-info "invalid pack zlib" {:reason :invalid-pack} e)))))]
       (when-not (= expected-size (count bytes))
         (throw (ex-info "pack object size mismatch" {:reason :pack-size})))
       [(ba bytes) end])))

(defn- parse-header [v p]
  (let [b0 (nth v p) code (bit-and (bit-shift-right b0 4) 7)]
    (loop [b b0 q (inc p) shift 4 size (bit-and b0 0x0f)]
      (if (zero? (bit-and b 0x80)) [code size q]
          (let [b' (nth v q)]
            (recur b' (inc q) (+ shift 7)
                   (bit-or size (bit-shift-left (bit-and b' 0x7f) shift))))))))

(defn decode
  "Decode PACK v2, verify trailer, and resolve deltas. Returns objects in pack
   order with :offset/:type/:body/:oid."
  [pack]
  (let [pack (ba pack) v (vec (map u8 pack)) n (count v)]
    (when-not (= "PACK" (apply str (map char (subvec v 0 (min 4 n)))))
      (throw (ex-info "bad pack magic" {:reason :pack-magic})))
    (when-not (= 2 (read-u32 v 4)) (throw (ex-info "unsupported pack version" {:reason :pack-version})))
    (when-not (= (vec (map u8 (sha1 (subvec v 0 (- n 20))))) (subvec v (- n 20) n))
      (throw (ex-info "pack checksum mismatch" {:reason :pack-checksum})))
    (let [count (read-u32 v 8)]
      (loop [i 0 p 12 out []]
        (if (= i count)
          out
          (let [offset p [code size q0] (parse-header v p)
                [base-ref q] (cond
                               (= code 7) [(mf/hexify (subvec v q0 (+ q0 20))) (+ q0 20)]
                               (= code 6) (loop [q q0 b (nth v q0) d (bit-and (nth v q0) 0x7f)]
                                            (if (zero? (bit-and b 0x80)) [(- offset d) (inc q)]
                                                (let [b' (nth v (inc q))]
                                                  (recur (inc q) b' (+ (bit-shift-left (inc d) 7)
                                                                       (bit-and b' 0x7f))))))
                               :else [nil q0])
                [raw consumed] (inflate-at pack v q size)
                base (when base-ref
                       (if (= code 7)
                         (some #(when (= base-ref (:oid %)) %) out)
                         (some #(when (= base-ref (:offset %)) %) out)))
                body (if (#{6 7} code)
                       (do (when-not base (throw (ex-info "delta base missing" {:reason :delta-base})))
                           (delta/apply-delta (:body base) raw))
                       raw)
                type (if (#{6 7} code) (:type base) (code->type code))
                oid (object/object-oid type body)]
            (recur (inc i) (+ q consumed)
                   (conj out {:offset offset :type type :body body :oid oid
                              :packed-end (+ q consumed)}))))))))

(defn- crc32 [pack v offset end]
  #?(:clj (let [crc (CRC32.)]
            (.update crc ^bytes pack offset (- end offset))
            (.getValue crc))
     :cljs (checksum/crc32 (subvec v offset end))))

(defn encode-index-v2
  "Build Git pack index v2 for decoded objects and the complete pack bytes."
  [objects pack]
  (let [pack (ba pack) v (vec (map u8 pack)) n (count v)
        sorted (sort-by :oid objects) out (out-buf)]
    (write! out [0xff 0x74 0x4f 0x63])
    (write! out (u32 2))
    (let [freq (frequencies (map #(#?(:clj Integer/parseInt :cljs js/parseInt) (subs (:oid %) 0 2) 16)
                                 sorted))]
      (loop [i 0 cumulative 0]
        (when (< i 256)
          (let [next (+ cumulative (get freq i 0))]
            (write! out (u32 next)) (recur (inc i) next)))))
    (doseq [o sorted] (write! out (mf/unhex (:oid o))))
    (doseq [{:keys [offset packed-end]} sorted]
      (write! out (u32 (crc32 pack v offset packed-end))))
    (doseq [{:keys [offset]} sorted]
      (when (>= offset 0x80000000) (throw (ex-info "large pack offsets not supported" {:offset offset})))
      (write! out (u32 offset)))
    (write! out (subvec v (- n 20) n))
    (let [prefix (snapshot out)] (write! out (sha1 prefix)) (snapshot out))))
